{
  "schemaVersion": 1,
  "type": "bilingual_glossary",
  "sourceLanguage": "en",
  "targetLanguages": [
    "ru",
    "uk"
  ],
  "pronunciation": {
    "accent": "en-GB",
    "notation": "IPA"
  },
  "entries": [
    {
      "id": "gls_001",
      "sourceParagraphId": "ch129_p0006",
      "headword": "Bandersnatch",
      "ipa": "ˈbændəsnætʃ",
      "translations": {
        "ru": "Брандашмыг",
        "uk": "Брандашмиг"
      },
      "definition": "A dangerous predatory creature which pounces out and snatches unfortunate victims away."
    },
    {
      "id": "gls_002",
      "sourceParagraphId": "ch129_p0007",
      "headword": "Barrister",
      "ipa": "ˈbærɪstə",
      "translations": {
        "ru": "Барристер",
        "uk": "Баристер"
      },
      "definition": "A gentleman who gives expert legal opinions and pleadings in a court of law."
    },
    {
      "id": "gls_003",
      "sourceParagraphId": "ch129_p0008",
      "headword": "Bathing-Machine",
      "ipa": "ˈbeɪðɪŋməˈʃiːn",
      "translations": {
        "ru": "Купальная кабинка",
        "uk": "Купальна кабінка"
      },
      "definition": "A wheeled enclosure, used to allow modest sea-bathing in absolute seclusion."
    },
    {
      "id": "gls_004",
      "sourceParagraphId": "ch129_p0009",
      "headword": "Beamish",
      "ipa": "ˈbiːmɪʃ",
      "translations": {
        "ru": "Лучезарный",
        "uk": "Променистий"
      },
      "definition": "Joyful, celebratory and idealistic."
    },
    {
      "id": "gls_005",
      "sourceParagraphId": "ch129_p0010",
      "headword": "Bellman",
      "ipa": "ˈbelmən",
      "translations": {
        "ru": "городской глашатай",
        "uk": "міський оповісник"
      },
      "definition": "A town crier, who makes public announcements on behalf of the court (“Oyez,” “Hear ye, hear ye,” etc.)."
    },
    {
      "id": "gls_006",
      "sourceParagraphId": "ch129_p0011",
      "headword": "Blotting-Paper",
      "ipa": "ˈblɒtɪŋˈpeɪpə",
      "translations": {
        "ru": "Промокательная бумага",
        "uk": "Промокальний папір"
      },
      "definition": "A highly absorbent type of paper, used to quickly mop up ink stains."
    },
    {
      "id": "gls_007",
      "sourceParagraphId": "ch129_p0012",
      "headword": "Bolster",
      "ipa": "ˈbəʊlstə",
      "translations": {
        "ru": "подушка-валик",
        "uk": "подушка-валик"
      },
      "definition": "A long narrow pillow, typically used as a headrest or back support."
    },
    {
      "id": "gls_008",
      "sourceParagraphId": "ch129_p0013",
      "headword": "Boojum",
      "ipa": "ˈbuːdʒəm",
      "translations": {
        "ru": "Буджум",
        "uk": "Буджум"
      },
      "definition": "A Snark which has grown so powerful, so convinced of its own reality, that dreamers who behold it are snuffed out of existence."
    },
    {
      "id": "gls_009",
      "sourceParagraphId": "ch129_p0014",
      "headword": "Boots",
      "ipa": "buːts",
      "translations": {
        "ru": "чистильщик обуви",
        "uk": "чистильник взуття"
      },
      "definition": "Someone who shines and blackens boots for a living."
    },
    {
      "id": "gls_010",
      "sourceParagraphId": "ch129_p0015",
      "headword": "Borogove",
      "ipa": "ˈbɒrəɡəʊv",
      "translations": {
        "ru": "Борогов",
        "uk": "Борогов"
      },
      "definition": "A shaggy, long-legged bird, which looks like a mixture of a parrot, a toucan and a flamingo."
    },
    {
      "id": "gls_011",
      "sourceParagraphId": "ch129_p0016",
      "headword": "Bowsprit",
      "ipa": "ˈbaʊsprɪt",
      "translations": {
        "ru": "Бушприт",
        "uk": "Бушприт"
      },
      "definition": "The long pole that projects from the prow (front) of a ship to secure and extend the rigging."
    },
    {
      "id": "gls_012",
      "sourceParagraphId": "ch129_p0017",
      "headword": "Bridecake",
      "ipa": "ˈbraɪdkeɪk",
      "translations": {
        "ru": "Свадебный пирог",
        "uk": "Весільний пиріг"
      },
      "definition": "A Victorian wedding cake."
    },
    {
      "id": "gls_013",
      "sourceParagraphId": "ch129_p0018",
      "headword": "Brillig",
      "ipa": "ˈbrɪlɪɡ",
      "translations": {
        "ru": "Брильный",
        "uk": "Брильний"
      },
      "definition": "The time in the afternoon (4:00 PM) when you begin boiling things for dinner. The word may come from “broil,” but may also signify “bright light.”"
    },
    {
      "id": "gls_014",
      "sourceParagraphId": "ch129_p0019",
      "headword": "Brooch",
      "ipa": "brəʊtʃ",
      "translations": {
        "ru": "Брошь",
        "uk": "Брошка"
      },
      "definition": "A clasp or pin, which keeps a wrapping garment (such as a cloak or shawl) comfortably in place. The brooch is typically separate from the garment so that its position can be adjusted to allow for changes in wind, weather and so forth."
    },
    {
      "id": "gls_015",
      "sourceParagraphId": "ch129_p0020",
      "headword": "Ca’n’t",
      "ipa": "kɑːnt",
      "translations": {
        "ru": "не могу; не может (сокр. от cannot)",
        "uk": "не можу; не може (скор. від cannot)"
      },
      "definition": "The Victorian contraction for “cannot.” (The apostrophes, as placed, are Carroll’s preference.)"
    },
    {
      "id": "gls_016",
      "sourceParagraphId": "ch129_p0021",
      "headword": "Callay, Callooh",
      "ipa": "kəˌleɪ kəˈluː",
      "translations": {
        "ru": "Калла́й, Каллу́",
        "uk": "Каллай, Каллу"
      },
      "definition": "Calls of celebration, such as “Huzzah!”"
    },
    {
      "id": "gls_017",
      "sourceParagraphId": "ch129_p0022",
      "headword": "Castling",
      "ipa": "ˈkæsəlɪŋ",
      "translations": {
        "ru": "Рокировка",
        "uk": "Рокіровка"
      },
      "definition": "A move in chess, in which the rooks are moved to protect the king from attack. (In Looking-Glass Chess, castling involves simultaneous movement of the queens.)"
    },
    {
      "id": "gls_018",
      "sourceParagraphId": "ch129_p0023",
      "headword": "Caucus-Race",
      "ipa": "ˈkɔːkəsˈreɪs",
      "translations": {
        "ru": "Бег по кругу",
        "uk": "Біг по колу"
      },
      "definition": "A joke made on English political practices. A caucus is a meeting of members belonging to the same political party, while a race is a contest between political rivals. A caucus-race, then, is a pointless (but energetic!) contest between political allies."
    },
    {
      "id": "gls_019",
      "sourceParagraphId": "ch129_p0024",
      "headword": "Chimney-Piece",
      "ipa": "ˈtʃɪmniˈpiːs",
      "translations": {
        "ru": "Каминная полка",
        "uk": "Камінна полиця"
      },
      "definition": "The mantle shelf over a fireplace."
    },
    {
      "id": "gls_020",
      "sourceParagraphId": "ch129_p0025",
      "headword": "Coal-Scuttle",
      "ipa": "ˈkəʊlˈskʌtəl",
      "translations": {
        "ru": "Угольный ящик",
        "uk": "Вугільне відерце"
      },
      "definition": "A bucket used to store coal inside of a home or other building."
    },
    {
      "id": "gls_021",
      "sourceParagraphId": "ch129_p0026",
      "headword": "Comfits",
      "ipa": "ˈkʌmfɪts",
      "translations": {
        "ru": "драже; засахаренные семена",
        "uk": "драже; зацукроване насіння"
      },
      "definition": "Small Victorian candies, typically made with spices, fruit, nuts or other flavorful additions."
    },
    {
      "id": "gls_022",
      "sourceParagraphId": "ch129_p0027",
      "headword": "Contrariwise",
      "ipa": "ˌkɒntrəˈraɪwaɪz",
      "translations": {
        "ru": "Напротив",
        "uk": "Навпаки"
      },
      "definition": "“In opposition of that,” or “On the contrary.”"
    },
    {
      "id": "gls_023",
      "sourceParagraphId": "ch129_p0028",
      "headword": "Crab",
      "ipa": "kræb",
      "translations": {
        "ru": "неудачный гребок; «поймать краба»",
        "uk": "невдалий гребок; «спіймати краба»"
      },
      "definition": "A sloppy oar-stroke, which causes the water to pull at the oar (and thereby slowing movement and causing problems for the person stroking with the oar)."
    },
    {
      "id": "gls_024",
      "sourceParagraphId": "ch129_p0029",
      "headword": "Cravat",
      "ipa": "ˈkrævæt",
      "translations": {
        "ru": "Галстук",
        "uk": "Крават"
      },
      "definition": "A formal neckband worn by gentlemen in place of a tie."
    },
    {
      "id": "gls_025",
      "sourceParagraphId": "ch129_p0030",
      "headword": "Cucumber-Frame",
      "ipa": "ˈkjuːkʌmbəˈfreɪm",
      "translations": {
        "ru": "Огуречный парник",
        "uk": "Огірковий парник"
      },
      "definition": "A small greenhouse-like structure, used to accelerate the growth of cucumbers."
    },
    {
      "id": "gls_026",
      "sourceParagraphId": "ch129_p0031",
      "headword": "Curiouser",
      "ipa": "ˈkjʊəriəsə",
      "translations": {
        "ru": "Всё чудесатее",
        "uk": "Усе дивовижніше"
      },
      "definition": "Even more curious than curious. Famously bad English; we are left to wonder whether Carroll was affectionately quoting Alice Liddell."
    },
    {
      "id": "gls_027",
      "sourceParagraphId": "ch129_p0032",
      "headword": "Currants",
      "ipa": "ˈkʌrənts",
      "translations": {
        "ru": "коринка; мелкий изюм",
        "uk": "коринка; дрібні родзинки"
      },
      "definition": "Berries used in decorative foods."
    },
    {
      "id": "gls_028",
      "sourceParagraphId": "ch129_p0033",
      "headword": "Cut",
      "ipa": "kʌt",
      "translations": {
        "ru": "Оказать холодный приём",
        "uk": "Знехтувати"
      },
      "definition": "To socially slight someone by either failing to acknowledge their greeting, or pretending not to know them."
    },
    {
      "id": "gls_029",
      "sourceParagraphId": "ch129_p0034",
      "headword": "Daisy-Chain",
      "ipa": "ˈdeɪziˈtʃeɪn",
      "translations": {
        "ru": "Гирлянда из ромашек",
        "uk": "Ромашковий ланцюжок"
      },
      "definition": "A laurel, bracelet or string of daisies, created by picking the flowers and tying or weaving their stems together."
    },
    {
      "id": "gls_030",
      "sourceParagraphId": "ch129_p0035",
      "headword": "Deal Box",
      "ipa": "ˌdiːl ˈbɒks",
      "translations": {
        "ru": "Сосновая коробочка",
        "uk": "Соснова скринька"
      },
      "definition": "A small Victorian box, used to carry linen, keepsakes or miscellaneous items."
    },
    {
      "id": "gls_031",
      "sourceParagraphId": "ch129_p0036",
      "headword": "Earl",
      "ipa": "ɜːl",
      "translations": {
        "ru": "Граф",
        "uk": "Граф"
      },
      "definition": "A member of the English nobility. Historically, an Earl is more powerful than a Baron, but less powerful than a Duke or Marquis."
    },
    {
      "id": "gls_032",
      "sourceParagraphId": "ch129_p0037",
      "headword": "Edgar Atheling",
      "ipa": "ˌedɡər ˈæθəlɪŋ",
      "translations": {
        "ru": "Эдгар Этелинг",
        "uk": "Едгар Етелінг"
      },
      "definition": "The last member of the royal house of Cerdic, of Wessex. He was proclaimed king in 1066 A.D., but never crowned."
    },
    {
      "id": "gls_033",
      "sourceParagraphId": "ch129_p0038",
      "headword": "Edwin",
      "ipa": "ˈedwɪn",
      "translations": {
        "ru": "Эдвин",
        "uk": "Едвін"
      },
      "definition": "The Earl of Mercia in 1066 A.D. Along with his younger brother Morcar, he supported Edgar Atheling against the Normans."
    },
    {
      "id": "gls_034",
      "sourceParagraphId": "ch129_p0039",
      "headword": "Esq.",
      "ipa": "ɪˈskwaɪə",
      "translations": {
        "ru": "эсквайр; вежливое обозначение после имени",
        "uk": "есквайр; ввічливе позначення після імені"
      },
      "definition": "An abbreviation for Esquire (an unofficial formal title taken by someone of high, but not noble, status)."
    },
    {
      "id": "gls_035",
      "sourceParagraphId": "ch129_p0040",
      "headword": "Extinguisher",
      "originalHeadword": "Extinquisher",
      "ipa": "ɪkˈstɪŋɡwɪʃə",
      "translations": {
        "ru": "гасильник для свечи",
        "uk": "гасник для свічки"
      },
      "definition": "A Victorian candle snuffer."
    },
    {
      "id": "gls_036",
      "sourceParagraphId": "ch129_p0041",
      "headword": "Feather",
      "ipa": "ˈfeðə",
      "translations": {
        "ru": "проводка и разворот весла",
        "uk": "проводка й розворот весла"
      },
      "definition": "A gentle oar stroke that causes a boat to move through the water in rapid, controlled fashion. Compare Crab."
    },
    {
      "id": "gls_037",
      "sourceParagraphId": "ch129_p0042",
      "headword": "Fender",
      "ipa": "ˈfendə",
      "translations": {
        "ru": "каминная решётка; защитный экран",
        "uk": "камінна решітка; захисний екран"
      },
      "definition": "A protective screen that fits the base of the fireplace."
    },
    {
      "id": "gls_038",
      "sourceParagraphId": "ch129_p0043",
      "headword": "Fiddle-De-Dee",
      "ipa": "ˈfɪdəldəˈdiː",
      "translations": {
        "ru": "чепуха!",
        "uk": "нісенітниця!"
      },
      "definition": "An expression of impatience or mild annoyance."
    },
    {
      "id": "gls_039",
      "sourceParagraphId": "ch129_p0044",
      "headword": "Fiddlestick",
      "ipa": "ˈfɪdəlˌstɪk",
      "translations": {
        "ru": "чепуха!",
        "uk": "нісенітниця!"
      },
      "definition": "Informal. Roughly translated, “I don’t care what they say.”"
    },
    {
      "id": "gls_040",
      "sourceParagraphId": "ch129_p0045",
      "headword": "Finger-Post",
      "ipa": "ˈfɪŋɡəˈpəʊst",
      "translations": {
        "ru": "Указатель",
        "uk": "Дороговказ"
      },
      "definition": "A trail- or road-side sign post, pointing the direction to a particular town or feature."
    },
    {
      "id": "gls_041",
      "sourceParagraphId": "ch129_p0046",
      "headword": "Frabjous",
      "ipa": "ˈfræbdʒəs",
      "translations": {
        "ru": "«Фрабжный»",
        "uk": "«Фрабжний»"
      },
      "definition": "A portmanteau of “fabulous” and “joyous.” A “frabjous day,” therefore, is a momentously happy one, whereupon celebrations will occur."
    },
    {
      "id": "gls_042",
      "sourceParagraphId": "ch129_p0047",
      "headword": "Frumenty",
      "ipa": "frəˈmenti",
      "translations": {
        "ru": "Фрументи",
        "uk": "Фрументи"
      },
      "definition": "A dish similar to oatmeal, typically consisting of milk and boiled wheat."
    },
    {
      "id": "gls_043",
      "sourceParagraphId": "ch129_p0048",
      "headword": "Frumious",
      "ipa": "ˈfruːmiəs",
      "translations": {
        "ru": "«Фрумиозный»",
        "uk": "«Фруміозний»"
      },
      "definition": "A portmanteau of “fuming” and “furious.”"
    },
    {
      "id": "gls_044",
      "sourceParagraphId": "ch129_p0049",
      "headword": "Fudge",
      "ipa": "fʌdʒ",
      "translations": {
        "ru": "чепуха!",
        "uk": "нісенітниця!"
      },
      "definition": "An informal interjection, meaning “nonsense.”"
    },
    {
      "id": "gls_045",
      "sourceParagraphId": "ch129_p0050",
      "headword": "Galumph",
      "ipa": "ɡəˈlʌmf",
      "translations": {
        "ru": "«Галумфать»",
        "uk": "«Галумфати»"
      },
      "definition": "A portmanteau of “galloping” and “triumph”; in other words, to proudly walk in a thoroughly rambunctious manner."
    },
    {
      "id": "gls_046",
      "sourceParagraphId": "ch129_p0051",
      "headword": "Gimble",
      "ipa": "ˈɡɪmbəl",
      "translations": {
        "ru": "«Джинбиться»",
        "uk": "«Джимбитися»"
      },
      "definition": "To move in a circular fashion, reminiscent of a gimlet (a small metal tool)."
    },
    {
      "id": "gls_047",
      "sourceParagraphId": "ch129_p0052",
      "headword": "Gimlet",
      "ipa": "ˈɡɪmlɪt",
      "translations": {
        "ru": "Буравчик",
        "uk": "Свердлик"
      },
      "definition": "A small hand tool, used for drilling holes in leather, wood or cloth."
    },
    {
      "id": "gls_048",
      "sourceParagraphId": "ch129_p0053",
      "headword": "Going Messages",
      "ipa": "ˌɡəʊɪŋ ˈmesɪdʒɪz",
      "translations": {
        "ru": "«Ходить с поручениями»",
        "uk": "«Ходити з дорученнями»"
      },
      "definition": "The act of serving as either a messenger or postman on behalf of a superior."
    },
    {
      "id": "gls_049",
      "sourceParagraphId": "ch129_p0054",
      "headword": "Grog",
      "ipa": "ɡrɒɡ",
      "translations": {
        "ru": "Грог",
        "uk": "Грог"
      },
      "definition": "A mariner’s alcoholic drink, consisting of watered-down beer or rum."
    },
    {
      "id": "gls_050",
      "sourceParagraphId": "ch129_p0055",
      "headword": "Gyre",
      "ipa": "ɡaɪə",
      "translations": {
        "ru": "«Гайрить»",
        "uk": "«Гайрити»"
      },
      "definition": "To move in a circular fashion without losing one’s balance, like a gyroscope."
    },
    {
      "id": "gls_051",
      "sourceParagraphId": "ch129_p0056",
      "headword": "Haddock",
      "ipa": "ˈhædək",
      "translations": {
        "ru": "Пикша",
        "uk": "Пікша"
      },
      "definition": "A food fish, popularly used in fish and chips."
    },
    {
      "id": "gls_052",
      "sourceParagraphId": "ch129_p0057",
      "headword": "Hansom-Cab",
      "ipa": "ˈhænsəmˈkæb",
      "translations": {
        "ru": "Кэб Хансома",
        "uk": "Кеб Генсома"
      },
      "definition": "A buggy pulled by a single horse."
    },
    {
      "id": "gls_053",
      "sourceParagraphId": "ch129_p0058",
      "headword": "Hearth-Rug",
      "ipa": "ˈhɑːˈθrʌɡ",
      "translations": {
        "ru": "Коврик перед камином",
        "uk": "Килимок перед каміном"
      },
      "definition": "A heavy floor rug positioned in front of the fireplace."
    },
    {
      "id": "gls_054",
      "sourceParagraphId": "ch129_p0059",
      "headword": "Helmsman",
      "ipa": "ˈhelmzmən",
      "translations": {
        "ru": "Рулевой",
        "uk": "Стерновий"
      },
      "definition": "The mariner who stands at the wheel and steers the ship."
    },
    {
      "id": "gls_055",
      "sourceParagraphId": "ch129_p0060",
      "headword": "Jabberwock",
      "ipa": "ˈdʒæbəwɒk",
      "translations": {
        "ru": "Бармаглот",
        "uk": "Бурмоковт"
      },
      "definition": "A nonesuch draconian monster, which apparently haunted the world of Wonderland and Looking-Glass Land in the age of the Anglo-Saxons."
    },
    {
      "id": "gls_056",
      "sourceParagraphId": "ch129_p0061",
      "headword": "Jabberwocky",
      "ipa": "ˈdʒæbəwɒki",
      "translations": {
        "ru": "«Бармаглот»",
        "uk": "«Бурмоковт»"
      },
      "definition": "A poem written by Lewis Carroll. As a point of distinction, “Jabberwocky” refers to the poem, and “Jabberwock” is the name of the monster itself."
    },
    {
      "id": "gls_057",
      "sourceParagraphId": "ch129_p0062",
      "headword": "Joint",
      "ipa": "dʒɔɪnt",
      "translations": {
        "ru": "кусок мяса; жаркое",
        "uk": "шматок м’яса; печеня"
      },
      "definition": "A leg of meat."
    },
    {
      "id": "gls_058",
      "sourceParagraphId": "ch129_p0063",
      "headword": "Jubjub Bird",
      "ipa": "ˌdʒʌbdʒʌb ˈbɜːd",
      "translations": {
        "ru": "Птица Джубджуб",
        "uk": "Птах Джубджуб"
      },
      "definition": "A dangerous predatory bird, primarily found lurking and hooting on Jabberwock Isle."
    },
    {
      "id": "gls_059",
      "sourceParagraphId": "ch129_p0064",
      "headword": "Kid-Gloves",
      "ipa": "ˈkɪdɡˈlʌvz",
      "translations": {
        "ru": "лайковые перчатки",
        "uk": "лайкові рукавички"
      },
      "definition": "Gloves made from the leather of young goat."
    },
    {
      "id": "gls_060",
      "sourceParagraphId": "ch129_p0065",
      "headword": "Larboard",
      "ipa": "ˈlɑːbɔːd",
      "translations": {
        "ru": "левый борт",
        "uk": "лівий борт"
      },
      "definition": "Port; the left-hand side of a ship. (In later times, it was decided that “larboard” was too easy to mistake with “starboard,” especially during storms.)"
    },
    {
      "id": "gls_061",
      "sourceParagraphId": "ch129_p0066",
      "headword": "Limed Twig",
      "ipa": "ˌlaɪmd ˈtwɪɡ",
      "translations": {
        "ru": "Прут, намазанный птичьим клеем",
        "uk": "Прут, змащений пташиним клеєм"
      },
      "definition": "A twig covered in sticky birdlime, used to catch birds and other small animals (such as crabs)."
    },
    {
      "id": "gls_062",
      "sourceParagraphId": "ch129_p0067",
      "headword": "Lory",
      "ipa": "ˈlɔːri",
      "translations": {
        "ru": "Лори",
        "uk": "Лорі"
      },
      "definition": "A small, brightly-plumaged parrot."
    },
    {
      "id": "gls_063",
      "sourceParagraphId": "ch129_p0068",
      "headword": "Macassar-Oil",
      "ipa": "ˈmækəˌsɑːˈrɔɪl",
      "translations": {
        "ru": "макассаровое масло",
        "uk": "макасарова олія"
      },
      "definition": "Victorian hair oil, used by gentlemen."
    },
    {
      "id": "gls_064",
      "sourceParagraphId": "ch129_p0069",
      "headword": "Manxome",
      "ipa": "ˈmæŋksəm",
      "translations": {
        "ru": "«Манксомный»",
        "uk": "«Манксомний»"
      },
      "definition": "Fearsome and island-dwelling. The word is probably derived from “Manx,” meaning “from the Isle of Man.”"
    },
    {
      "id": "gls_065",
      "sourceParagraphId": "ch129_p0070",
      "headword": "Marmalade",
      "ipa": "ˈmɑːməˌleɪd",
      "translations": {
        "ru": "апельсиновый джем; мармелад",
        "uk": "апельсиновий джем; мармелад"
      },
      "definition": "A drink made from boiled fruit preserves and sugar."
    },
    {
      "id": "gls_066",
      "sourceParagraphId": "ch129_p0071",
      "headword": "Menai Bridge",
      "ipa": "ˌmenaɪ ˈbrɪdʒ",
      "translations": {
        "ru": "Мост Менай",
        "uk": "Міст Менай"
      },
      "definition": "One of the earliest modern suspension bridges, built in 1826."
    },
    {
      "id": "gls_067",
      "sourceParagraphId": "ch129_p0072",
      "headword": "Mimsiest",
      "ipa": "ˈmɪmziɪst",
      "translations": {
        "ru": "«Мимзейшее»",
        "uk": "«Мімзіше»"
      },
      "definition": "The most flimsy and miserable state possible for a living creature."
    },
    {
      "id": "gls_068",
      "sourceParagraphId": "ch129_p0073",
      "headword": "Mimsy",
      "ipa": "ˈmɪmzi",
      "translations": {
        "ru": "«Мимзи»",
        "uk": "«Мімзі»"
      },
      "definition": "A portmanteau of “flimsy” and “miserable.”"
    },
    {
      "id": "gls_069",
      "sourceParagraphId": "ch129_p0074",
      "headword": "Mince-Pie",
      "ipa": "ˈmɪnˈspaɪ",
      "translations": {
        "ru": "сладкий пирожок с сухофруктами (минс-пай)",
        "uk": "солодкий пиріжок із сухофруктами (мінс-пай)"
      },
      "definition": "A pastry filled with mincemeat (a mixture of spiced beef, fruit and distilled spirits)."
    },
    {
      "id": "gls_070",
      "sourceParagraphId": "ch129_p0075",
      "headword": "Mock Turtle",
      "ipa": "ˌmɒk ˈtɜːtəl",
      "translations": {
        "ru": "Черепаха Квази",
        "uk": "Фальшива Черепаха"
      },
      "definition": "A curious creature of Wonderland, with the body of a turtle and the head of a calf."
    },
    {
      "id": "gls_071",
      "sourceParagraphId": "ch129_p0076",
      "headword": "Mome",
      "ipa": "məʊm",
      "translations": {
        "ru": "«Моум»",
        "uk": "«Моум»"
      },
      "definition": "An archaic contraction of “from home,” which is to say “lost.”"
    },
    {
      "id": "gls_072",
      "sourceParagraphId": "ch129_p0077",
      "headword": "Morcar",
      "ipa": "ˈmɔːkɑː",
      "translations": {
        "ru": "Моркар",
        "uk": "Моркар"
      },
      "definition": "The Earl of Northumbria in 1066 A.D. Along with his elder brother Edwin, he supported Edgar Atheling against the Normans."
    },
    {
      "id": "gls_073",
      "sourceParagraphId": "ch129_p0078",
      "headword": "Muchness",
      "ipa": "ˈmʌtʃnəs",
      "translations": {
        "ru": "«Многость»",
        "uk": "«Багатість»"
      },
      "definition": "A lavish amount of something; or, just extravagance in general."
    },
    {
      "id": "gls_074",
      "sourceParagraphId": "ch129_p0079",
      "headword": "Mutton-Pie",
      "ipa": "ˈmʌtənˈpaɪ",
      "translations": {
        "ru": "Пирог с бараниной",
        "uk": "Пиріг із бараниною"
      },
      "definition": "A lamb’s meat pie."
    },
    {
      "id": "gls_075",
      "sourceParagraphId": "ch129_p0080",
      "headword": "Natural History",
      "ipa": "ˌnætʃərəl ˈhɪstəri",
      "translations": {
        "ru": "Естественная история",
        "uk": "Природнича історія"
      },
      "definition": "The science of researching plants and animals, primarily through observation (as opposed to experimentation)."
    },
    {
      "id": "gls_076",
      "sourceParagraphId": "ch129_p0081",
      "headword": "Northumbria",
      "ipa": "nɔːˈθʌmbriə",
      "translations": {
        "ru": "Нортумбрия",
        "uk": "Нортумбрія"
      },
      "definition": "A kingdom of medieval England, prior to the Norman invasion. The land is currently known as the County of Northumberland."
    },
    {
      "id": "gls_077",
      "sourceParagraphId": "ch129_p0082",
      "headword": "Nosegay",
      "ipa": "ˈnəʊsɡeɪ",
      "translations": {
        "ru": "Букетик",
        "uk": "Букетик"
      },
      "definition": "A small bouquet of flowers, typically given as a gift."
    },
    {
      "id": "gls_078",
      "sourceParagraphId": "ch129_p0083",
      "headword": "Nurse",
      "ipa": "nɜːs",
      "translations": {
        "ru": "няня; кормилица",
        "uk": "няня; годувальниця"
      },
      "definition": "In Victorian use, a female servant entrusted with the care of the children."
    },
    {
      "id": "gls_079",
      "sourceParagraphId": "ch129_p0084",
      "headword": "Outgrabe",
      "ipa": "ˌaʊtˈɡreɪb",
      "translations": {
        "ru": "«Аутгрейб»",
        "uk": "«Аутгрейб»"
      },
      "definition": "A strange sound of surprise or despair, which sounds like bellowing, whistling and sneezing, all at once."
    },
    {
      "id": "gls_080",
      "sourceParagraphId": "ch129_p0085",
      "headword": "Papers",
      "ipa": "ˈpeɪpəz",
      "translations": {
        "ru": "бумажные папильотки",
        "uk": "паперові папільйотки"
      },
      "definition": "Victorian hair curlers."
    },
    {
      "id": "gls_081",
      "sourceParagraphId": "ch129_p0086",
      "headword": "Plaster",
      "ipa": "ˈplæstə",
      "translations": {
        "ru": "пластырь; повязка",
        "uk": "пластир; пов’язка"
      },
      "definition": "A small bandage."
    },
    {
      "id": "gls_082",
      "sourceParagraphId": "ch129_p0087",
      "headword": "Portmanteau",
      "ipa": "ˈpɔːtmænˌtəʊ",
      "translations": {
        "ru": "саквояж; слово-бумажник",
        "uk": "саквояж; слово-гаманець"
      },
      "definition": "A suitcase which has two identically-sized compartments. (In Humpty Dumpty’s usage, a portmanteau is a word with two meanings, or a word made up of two other words; such as “slithy” from “lithe” and “slimy.”)"
    },
    {
      "id": "gls_083",
      "sourceParagraphId": "ch129_p0088",
      "headword": "Quadrille",
      "ipa": "ˈkwɒdrɪl",
      "translations": {
        "ru": "Кадриль",
        "uk": "Кадриль"
      },
      "definition": "A formal and difficult Victorian dance, emphasizing the importance of pairs’ coordination."
    },
    {
      "id": "gls_084",
      "sourceParagraphId": "ch129_p0089",
      "headword": "Railway-Share",
      "ipa": "ˈreɪlweɪˈʃeə",
      "translations": {
        "ru": "Железнодорожная акция",
        "uk": "Залізнична акція"
      },
      "definition": "A stock investing in trains and railroads. Due to the rapid and wild growth of the English rail system in Victorian times, railway-shares were potentially lucrative but very risky investments."
    },
    {
      "id": "gls_085",
      "sourceParagraphId": "ch129_p0090",
      "headword": "Rath",
      "ipa": "rɑːθ",
      "translations": {
        "ru": "Раты",
        "uk": "Рати"
      },
      "definition": "Greenish, pig-like creatures which tend to wander about in an aimless fashion, squealing all the while."
    },
    {
      "id": "gls_086",
      "sourceParagraphId": "ch129_p0091",
      "headword": "Sal-Volatile",
      "ipa": "ˈsælˈvɒləˌtaɪl",
      "translations": {
        "ru": "нюхательная соль",
        "uk": "нюхальна сіль"
      },
      "definition": "Smelling salts."
    },
    {
      "id": "gls_087",
      "sourceParagraphId": "ch129_p0092",
      "headword": "Sealing-Wax",
      "ipa": "ˈsiːlɪŋˈwæks",
      "translations": {
        "ru": "Сургуч",
        "uk": "Сургуч"
      },
      "definition": "Wax which is melted and then allowed to cool, creative a seal to keep a letter or scroll closed."
    },
    {
      "id": "gls_088",
      "sourceParagraphId": "ch129_p0093",
      "headword": "Set to Partners",
      "ipa": "ˌset tə ˈpɑːtnəz",
      "translations": {
        "ru": "«Встать к партнёру»",
        "uk": "«Стати до партнера»"
      },
      "definition": "A slight formal dance move, in which two partners face one another and hop from one foot to the other."
    },
    {
      "id": "gls_089",
      "sourceParagraphId": "ch129_p0094",
      "headword": "Sha’n’t",
      "ipa": "ʃɑːnt",
      "translations": {
        "ru": "не стану; не буду (сокр. от shall not)",
        "uk": "не стану; не буду (скор. від shall not)"
      },
      "definition": "The Victorian contraction for “shall not.” (The apostrophes, as placed, are Carroll’s preference.)"
    },
    {
      "id": "gls_090",
      "sourceParagraphId": "ch129_p0095",
      "headword": "Shavings",
      "ipa": "ˈʃeɪvɪŋz",
      "translations": {
        "ru": "стружки",
        "uk": "стружки"
      },
      "definition": "Small pieces of wood."
    },
    {
      "id": "gls_091",
      "sourceParagraphId": "ch129_p0096",
      "headword": "Slithy",
      "ipa": "ˈslaɪði",
      "translations": {
        "ru": "хливкий",
        "uk": "хливкий"
      },
      "definition": "A portmanteau of “lithe” and “slimy,” with a hint of “slithering.”"
    },
    {
      "id": "gls_092",
      "sourceParagraphId": "ch129_p0097",
      "headword": "Snark",
      "ipa": "snɑːk",
      "translations": {
        "ru": "Снарк",
        "uk": "Снарк"
      },
      "definition": "A fabulous creature, particularly found on Jabberwock Isle. Snarks may be created from the stray fears and secret doubts of adventurous dreamers."
    },
    {
      "id": "gls_093",
      "sourceParagraphId": "ch129_p0098",
      "headword": "Snarked",
      "ipa": "snɑːkt",
      "translations": {
        "ru": "заснаркованный; застрявший невозможным образом",
        "uk": "заснаркований; застряглий неможливим чином"
      },
      "definition": "To be stuck in an impossible way, or in an impossible place. (Alice could be said to be “snarked” when she falls into Wonderland.)"
    },
    {
      "id": "gls_094",
      "sourceParagraphId": "ch129_p0099",
      "headword": "Snicker-Snack",
      "ipa": "ˌsnɪkəˈsnæk",
      "translations": {
        "ru": "вжик-вжик (звук и движение клинка)",
        "uk": "вжик-вжик (звук і рух клинка)"
      },
      "definition": "The sound and motion of a very sharp blade which is being used in battle. The term comes from the “snickersnee,” an antiquated combat knife."
    },
    {
      "id": "gls_095",
      "sourceParagraphId": "ch129_p0100",
      "headword": "Soup-Tureen",
      "ipa": "ˈsuːptjəˈriːn",
      "translations": {
        "ru": "супница",
        "uk": "супниця"
      },
      "definition": "A large, deep serving dish."
    },
    {
      "id": "gls_096",
      "sourceParagraphId": "ch129_p0101",
      "headword": "Spright",
      "ipa": "spraɪt",
      "translations": {
        "ru": "фея; живость",
        "uk": "фея; жвавість"
      },
      "definition": "A small fairy (sprite, pixie). In Carroll’s poetic use, this probably means “sprightliness,” or animated and vivacious gestures."
    },
    {
      "id": "gls_097",
      "sourceParagraphId": "ch129_p0102",
      "headword": "Starboard",
      "ipa": "ˈstɑːbəd",
      "translations": {
        "ru": "правый борт",
        "uk": "правий борт"
      },
      "definition": "The right-hand side of a ship. Compare Larboard."
    },
    {
      "id": "gls_098",
      "sourceParagraphId": "ch129_p0103",
      "headword": "Stigand",
      "ipa": "ˈstɪɡænd",
      "translations": {
        "ru": "Стиганд",
        "uk": "Стіганд"
      },
      "definition": "An English churchman prior to the Norman conquest."
    },
    {
      "id": "gls_099",
      "sourceParagraphId": "ch129_p0104",
      "headword": "Stuff",
      "ipa": "stʌf",
      "translations": {
        "ru": "чепуха!",
        "uk": "нісенітниця!"
      },
      "definition": "Informal interjection, meaning “rubbish.”"
    },
    {
      "id": "gls_100",
      "sourceParagraphId": "ch129_p0105",
      "headword": "Suet",
      "ipa": "ˈsuːɪt",
      "translations": {
        "ru": "нутряной жир; сало",
        "uk": "нутряний жир; лій"
      },
      "definition": "Hard fatty tissue in a food meat (such as mutton or beef)."
    },
    {
      "id": "gls_101",
      "sourceParagraphId": "ch129_p0106",
      "headword": "Suety",
      "ipa": "ˈsuːti",
      "translations": {
        "ru": "сальный; похожий на нутряной жир",
        "uk": "сальний; подібний до нутряного жиру"
      },
      "definition": "With the consistency of suet."
    },
    {
      "id": "gls_102",
      "sourceParagraphId": "ch129_p0107",
      "headword": "Sugar-Loaf",
      "ipa": "ˈʃʊɡəˈləʊf",
      "translations": {
        "ru": "шляпа «сахарная голова»",
        "uk": "капелюх «цукрова голова»"
      },
      "definition": "A tall, conical traveler’s hat, typically worn while riding."
    },
    {
      "id": "gls_103",
      "sourceParagraphId": "ch129_p0108",
      "headword": "Teetotum",
      "ipa": "ˈtiːtɒtəm",
      "translations": {
        "ru": "волчок с цифрами",
        "uk": "дзиґа з цифрами"
      },
      "definition": "A spinning toy top, decorated with numbers."
    },
    {
      "id": "gls_104",
      "sourceParagraphId": "ch129_p0109",
      "headword": "Thingumbob",
      "ipa": "ˈθɪŋəmbɒb",
      "translations": {
        "ru": "как-бишь-его; эй, приятель",
        "uk": "як-його-там; гей, друже"
      },
      "definition": "A nonsense name of jovial familiarity, somewhat warmer than “Hey you.”"
    },
    {
      "id": "gls_105",
      "sourceParagraphId": "ch129_p0110",
      "headword": "Tipple",
      "ipa": "ˈtɪpəl",
      "translations": {
        "ru": "опрокинуть лодку на зыби",
        "uk": "перекинути човен на хвилях"
      },
      "definition": "In Carroll’s use, “tipple” means to tip a boat over in rippling water."
    },
    {
      "id": "gls_106",
      "sourceParagraphId": "ch129_p0111",
      "headword": "Tove",
      "ipa": "təʊv",
      "translations": {
        "ru": "шорёк; тоув",
        "uk": "шорок; тоув"
      },
      "definition": "Badger-like creatures which have corkscrew-shaped snouts (to facilitate rapid burrowing)."
    },
    {
      "id": "gls_107",
      "sourceParagraphId": "ch129_p0112",
      "headword": "Transportation",
      "ipa": "trænspɔːˈteɪʃən",
      "translations": {
        "ru": "каторжная ссылка; высылка",
        "uk": "каторжне заслання; вислання"
      },
      "definition": "The act of deporting convicted criminals (typically, in England’s case, to Australia)."
    },
    {
      "id": "gls_108",
      "sourceParagraphId": "ch129_p0113",
      "headword": "Treacle",
      "ipa": "ˈtriːkəl",
      "translations": {
        "ru": "патока; целебная минеральная вода",
        "uk": "патока; цілюща мінеральна вода"
      },
      "definition": "Medicinal mineral water or molasses."
    },
    {
      "id": "gls_109",
      "sourceParagraphId": "ch129_p0114",
      "headword": "Tulgey Wood",
      "ipa": "ˈtʌldʒi wʊd",
      "translations": {
        "ru": "Тугодумный лес",
        "uk": "Тугий ліс"
      },
      "definition": "“Tulgey” can be understood to mean “tumored” and “bulgy,” which means an ancient forest filled with disturbingly twisted trees."
    },
    {
      "id": "gls_110",
      "sourceParagraphId": "ch129_p0115",
      "headword": "Tumtum Tree",
      "ipa": "ˈtʌmtʌm triː",
      "translations": {
        "ru": "дерево Тумтум",
        "uk": "дерево Тумтум"
      },
      "definition": "A timeless species of the willow, engendering feelings of calm and wisdom, which only grows in the most remote corners of the lands of fancy."
    },
    {
      "id": "gls_111",
      "sourceParagraphId": "ch129_p0116",
      "headword": "Turtle Soup",
      "ipa": "ˌtɜːtəl ˈsuːp",
      "translations": {
        "ru": "черепаховый суп",
        "uk": "черепаховий суп"
      },
      "definition": "A fancy soup made from turtle meat. In Victorian times, turtle meat was very expensive; “Mock Turtle Soup” refers to turtle soup made with a different kind of meat, but otherwise the same recipe. (Jokingly, Carroll created the Mock Turtle character to explain where mock turtle meat came from.)"
    },
    {
      "id": "gls_112",
      "sourceParagraphId": "ch129_p0117",
      "headword": "Uffish",
      "ipa": "ˈʌfɪʃ",
      "translations": {
        "ru": "угрюмо-пыхтящий; хмурый",
        "uk": "хмуро-сопучий; хмурий"
      },
      "definition": "Gruff, rough and huffing, all at once."
    },
    {
      "id": "gls_113",
      "sourceParagraphId": "ch129_p0118",
      "headword": "Vorpal",
      "ipa": "ˈvɔːpəl",
      "translations": {
        "ru": "вострый; волшебно-острый",
        "uk": "ворпальний; чарівно-небезпечний"
      },
      "definition": "Astral, arcane, dangerously magical."
    },
    {
      "id": "gls_114",
      "sourceParagraphId": "ch129_p0119",
      "headword": "Wabe",
